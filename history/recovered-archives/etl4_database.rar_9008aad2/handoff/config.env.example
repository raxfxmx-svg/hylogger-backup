# Reference only: tools/handoff.py reads process environment variables.
# This file is NOT automatically loaded. Configure your own terminal or service.
# Never write real credentials into a package that will be shared.

ETL4_ADMIN_DSN=host=REPLACE_ME port=5432 dbname=etl4_core user=REPLACE_ME password=REPLACE_ME sslmode=verify-full sslrootcert=REPLACE_ME
ETL4_READ_DSN=host=REPLACE_ME port=5432 dbname=etl4_core user=etl4_reader password=REPLACE_ME sslmode=verify-full sslrootcert=REPLACE_ME
# Optional non-interactive password for create-reader; otherwise it prompts.
# ETL4_READER_PASSWORD=REPLACE_ME
# Optional AWS profile for the S3 transfer commands. SDK provider defaults also work.
# AWS_PROFILE=REPLACE_ME
