# The real .env file must stay local and must not contain the postgres account.
HYLOGGER_DB_HOST=localhost
HYLOGGER_DB_PORT=5432
HYLOGGER_DB_NAME=hylogger
HYLOGGER_DB_USER=hylogger_api_local
HYLOGGER_DB_PASSWORD=replace-with-a-local-secret
HYLOGGER_DB_SET_ROLE=
HYLOGGER_DATA_ROOT=C:\Users\your-name\path\to\demo2\data\processed
HYLOGGER_API_HOST=127.0.0.1
HYLOGGER_API_PORT=8000
HYLOGGER_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
